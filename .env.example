# Copy to .env (cp .env.example .env). Never commit .env.

# ---------- Local development (docker-compose.yml) ----------
POSTGRES_USER=synchronic
POSTGRES_PASSWORD=synchronic
POSTGRES_DB=synchronic
DATABASE_URL=postgresql://synchronic:synchronic@db:5432/synchronic
REDIS_URL=redis://redis:6379/0

# Dev-only secret. In production this MUST be random, 32+ chars (the services refuse to start otherwise):
#   openssl rand -hex 32
JWT_SECRET=change-me-dev-secret

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the app is served same-origin (dev proxy / production Caddy).
CORS_ORIGINS=http://localhost:5173

# Optional pgAdmin (docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ---------- Production (docker-compose.prod.yml) ----------
# Use URL-safe values (openssl rand -hex 24) - they are embedded in connection URLs.
# POSTGRES_PASSWORD=...
# REDIS_PASSWORD=...
# JWT_SECRET=...
# Domain for automatic HTTPS, or ":80" for plain HTTP behind your own TLS proxy.
# SITE_ADDRESS=docs.example.com
